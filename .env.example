# Copy to .env (never commit .env). Read by systemd, scripts/supabase.sh and discord-notify.sh.

# Where this repo lives on the server
FLOWPILOT_HOME=/home/ubuntu/flowpilot
# Used by the skill's date anchor. Should match flowpilot_state.timezone
FLOWPILOT_TZ=America/New_York

# Supabase (Project Settings > API). Service role key: server only, never in a client app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres for sb_sql (Connect > Transaction pooler)
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=

# Crash alerts. The bot token is read from the Discord plugin's own .env
# (~/.claude/channels/discord/.env). Channel ID: right-click the channel > Copy Channel ID.
DISCORD_ALERT_CHANNEL_ID=
